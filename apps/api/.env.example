# Kopyala: .env.example -> .env
# Varsayılan değer, apps/api/docker-compose.yml'deki local Postgres servisiyle eşleşir.
DATABASE_URL=postgres://linguascroll:linguascroll@localhost:5432/linguascroll

# Chunk 8: feed pagination cursor'ının HMAC imzası için secret (bkz. feed-cursor.ts).
# Confidentiality değil tamper-detection amaçlı — yine de gerçek bir rastgele değer
# kullanın (örn. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
FEED_CURSOR_SECRET=replace-with-a-random-64-char-hex-secret

# Chunk 12 — content-enrichment pipeline'ı (bkz. src/content-enrichment/). Sadece
# `pnpm enrich` çalıştırırken okunuyor; ana NestJS uygulaması (app.module.ts) bu
# değişkeni hiç bilmiyor/gerektirmiyor.
# Chunk 15 — Anthropic'ten Gemini'ye geçildi (ücretsiz tier). AI Studio'dan
# alınan key buraya yazılır: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsiyonel — boş bırakılırsa enrichment-llm-client.ts'teki DEFAULT_MODEL
# kullanılır. Yeni bir Gemini modeline geçmek için kod değişikliği GEREKMEZ,
# sadece burayı değiştirin.
CONTENT_ENRICHMENT_MODEL=

# Chunk 17 — Cloudflare R2 (bkz. src/content-admin/r2-storage.service.ts).
# app.module.ts'teki global env doğrulamasının PARÇASI DEĞİL (bkz. o dosyadaki
# yorum) — sadece POST /content-admin/videos/upload çağrıldığında okunuyor.
# Cloudflare dashboard: R2 > Manage R2 API Tokens'tan üretilir.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket'ın public erişim domaini (r2.dev subdomain'i ya da bağladığınız custom
# domain) — sonunda "/" olsun ya da olmasın fark etmez (bkz. R2StorageService.buildPlaybackUrl).
R2_PUBLIC_BASE_URL=
