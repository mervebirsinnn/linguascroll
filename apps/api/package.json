{
  "name": "@linguascroll/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "node dist/videos/seed-videos.js",
    "seed:transcripts": "node dist/videos/seed-transcript-segments.js",
    "seed:quizzes": "node dist/quizzes/seed-quizzes.js",
    "seed:words": "node dist/words/seed-words.js",
    "test": "jest",
    "stt:build": "tsc -p scripts/stt/tsconfig.json",
    "stt:test": "jest -c scripts/stt/jest.config.js",
    "stt:process": "pnpm run stt:build && node scripts/stt/dist/run-stt-pipeline.js"
  },
  "dependencies": {
    "@linguascroll/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
