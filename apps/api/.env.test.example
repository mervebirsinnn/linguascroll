# Kopyala: .env.test.example -> .env.test
# DATABASE_URL'den TAMAMEN AYRI bir contract — testler asla DATABASE_URL'e
# fallback yapmaz. Aynı Postgres container'ı içinde ayrı bir veritabanı
# (linguascroll_test), ayrı bir container/servis DEĞİL.
TEST_DATABASE_URL=postgres://linguascroll:linguascroll@localhost:5432/linguascroll_test

# Chunk 8: bkz. .env.example'daki FEED_CURSOR_SECRET yorumu — test suite'i kendi
# ayrı secret'ını kullanır, dev'inkiyle aynı olmak zorunda değil.
FEED_CURSOR_SECRET=replace-with-a-random-64-char-hex-secret

# Deploy prep: bkz. .env.example'daki CONTENT_ADMIN_SECRET yorumu — content-admin
# e2e testleri (content-admin.e2e-spec.ts) gerçek Nest HTTP katmanından geçtiği için
# guard'ın (content-admin-secret.guard.ts) doğru X-Admin-Secret header'ını görmesi
# gerekiyor. Gerçek bir secret DEĞİL, sabit bir test değeri.
CONTENT_ADMIN_SECRET=test-only-content-admin-secret
