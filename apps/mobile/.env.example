# Kopyala: .env.example -> .env, sonra kendi dev makinenin LAN IP'sini yaz.
# "localhost" fiziksel cihazda ÇALIŞMAZ (telefon kendi localhost'una gider, dev
# makinesine değil). Sadece web/simulator'de localhost yeterlidir.
# EXPO_PUBLIC_ önekli değişkenler Expo tarafından otomatik olarak process.env'e
# gömülür — ek bir kütüphane/config sistemi gerekmez.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.29:3000

# Sentry DSN secret DEĞİL (public key), ama yine de yerel/preview/production
# arasında farklı olabilir. Yerel dev için buraya kendi dev Sentry projenin
# DSN'ini yaz (boş bırakılırsa instrument.ts Sentry'yi no-op olarak başlatır).
# preview/production build'lerde BU DOSYA/.env.production DEĞİL, EAS build
# environment (eas env:create, "EXPO_PUBLIC_SENTRY_DSN") kaynak — bkz.
# .env.production'daki not.
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat ANDROID PUBLIC SDK anahtarı (RevenueCat dashboard > Project settings > API keys >
# "Google Play" public key; "goog_" ile başlar). Secret key DEĞİL — gizli REST anahtarı sadece
# backend'de (apps/api REVENUECAT_SECRET_API_KEY). Tanımsızsa satın alma kapalı kalır, paywall
# "yüklenemedi" gösterir. preview/production build'lerde EAS environment'tan gelir
# (eas env:create --name EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY --visibility plaintext).
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Firebase Authentication (Google ile giriş) — 2026-10-27. GİZLİ DEĞİL (istemciye gömülmek için
# tasarlanmış web config). Firebase Console > Project settings > General > "Your apps" > Web app
# (</>) > SDK setup and configuration > Config. Tanımsızsa giriş ekranı "yapılandırma eksik" gösterir.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs > "Web client"
# (Firebase Google sağlayıcısını açınca otomatik oluşur). Google ID token'ının audience'ı.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
