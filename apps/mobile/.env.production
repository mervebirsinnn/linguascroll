# Expo CLI, NODE_ENV=production olduğunda (eas build / expo export varsayılanı)
# bu dosyayı .env'in ÜSTÜNE yükler (bkz. @expo/env getEnvFiles önceliği:
# .env.production, .env'den önce gelir) — bu yüzden production build'ler LAN
# IP'si içeren .env'i DEĞİL, buradaki gerçek API URL'ini kullanır. Dev akışı
# (`pnpm start`) NODE_ENV=development ile çalıştığı için bu dosyayı hiç
# görmez, .env'deki LAN IP'si aynen çalışmaya devam eder.
EXPO_PUBLIC_API_BASE_URL=https://looplish-api.onrender.com

# EXPO_PUBLIC_SENTRY_DSN BİLİNÇLİ OLARAK burada YOK: preview/production
# build'lerin Sentry DSN'i, committed bir dotenv dosyası yerine EAS build
# environment'tan (eas env:create --environment production/preview,
# visibility plaintext) okunacak şekilde tasarlandı — eas.json'daki
# "development"/"preview"/"production" profil adları, EAS'in standart
# environment adlarıyla otomatik eşleşiyor, build profilinde ayrıca
# "environment" alanı belirtmeye gerek yok. Bu dosyaya DSN eklemek, o
# otomatik eşleşmeyi es geçip yanlışlıkla hep bu dosyadaki (statik, git'e
# commit'lenmiş) değeri kullanmaya döner.
